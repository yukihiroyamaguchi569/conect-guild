{
  "name": "conect-guild",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.10.0"
  },
  "workspaces": [
    "apps/web",
    "packages/collector",
    "packages/snapshot"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web --",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "typecheck": "vue-tsc -p apps/web/tsconfig.app.json && tsc -p apps/web/tsconfig.node.json && tsc -p apps/web/tsconfig.e2e.json && tsc -p packages/snapshot/tsconfig.json && tsc -p packages/collector/tsconfig.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "collect:once": "node packages/collector/src/main.ts --once",
    "collect": "node packages/collector/src/main.ts",
    "settings:write": "node packages/collector/src/settingsWriteMain.ts",
    "dev:all": "concurrently --kill-others --names collect,web --prefix-colors auto \"npm run collect\" \"npm run dev\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
