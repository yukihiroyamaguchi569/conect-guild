{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-settings.ts",
    "vite-plugin-settings.test.ts",
    "vite-plugin-snapshot.ts",
    "vite-plugin-snapshot.test.ts",
    "dev-host.test.ts"
  ]
}
